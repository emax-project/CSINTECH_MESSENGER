# Docker Compose 배포 시 이 파일을 .env로 복사하여 사용
# JWT_SECRET은 GitHub Actions Secrets에 등록

# 서버 3001 포트를 게시할 주소. 기본값(0.0.0.0)은 외부에서도 접속 가능.
# Caddy가 같은 compose 안에서 연결하는 구성이면 127.0.0.1 로 제한할 수 있다.
# SERVER_BIND=127.0.0.1

# 그룹웨어 SSO 토큰 검증용 공유 키 (그룹웨어 서버와 같은 값, 긴 랜덤 문자열 — 예: openssl rand -base64 32)
# SSO_SHARED_KEY=
# 그룹웨어 → 메신저 내부 API(겸직 동기화) 공유 비밀번호. `openssl rand -hex 32`로 만들어 그룹웨어와 같은 값을 넣는다
# INTEGRATION_SHARED_SECRET=
# 로그인 토큰을 발급일(한국 시간) 당일 자정까지만 인정(true). 모바일 앱도 매일 다시 로그인하게 되므로 확인 후 켠다
# SESSION_EXPIRE_AT_MIDNIGHT=true
