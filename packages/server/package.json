{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "build": "echo 'No build step'",
    "lint": "eslint \"src/**/*.js\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "node scripts/seed.js",
    "db:seed:mentions": "node scripts/seed-mentions.js",
    "db:seed:memos": "node scripts/seed-memos.js",
    "db:seed:agendas": "node scripts/seed-agendas.js",
    "db:seed:announcement": "node scripts/seed-announcement.js",
    "check:avatar": "node scripts/check-avatar.js",
    "partner:org:sync": "node scripts/sync-partner-org.js",
    "partner:org:sync:dry": "node scripts/sync-partner-org.js --dry-run",
    "partner:org:sync:users": "node scripts/sync-partner-org.js --create-users",
    "partner:org:sync:users:dry": "node scripts/sync-partner-org.js --create-users --dry-run",
    "ldap:check": "node scripts/check-ldap.js",
    "admin:create": "node scripts/create-admin.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "ldapts": "^7.4.0",
    "mssql": "^11.0.1",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "@types/node-cron": "^3.0.11",
    "eslint": "^8.56.0",
    "prisma": "^5.22.0",
    "typescript": "^5.6.3"
  }
}
