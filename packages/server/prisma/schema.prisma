generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id           String       @id @default(cuid())
  name         String
  // 조직도·부서 관리 화면에서의 조회 순번. 작을수록 먼저 나온다.
  sortOrder    Int          @default(0)
  /// 거래처 MSSQL 사업장/법인 코드 등 외부 키 (동기화용)
  externalCode String?      @unique
  /// 회사 주소 (프로필 상세 표기용)
  address      String?
  departments  Department[]
}

// 직급 추천 목록.
// 실제 직급 값은 User.jobTitle 문자열에 그대로 남는다(관계가 아니다).
// 이 표는 아직 아무도 쓰지 않는 직급도 목록에 띄우기 위한 마스터일 뿐이라,
// 여기 없는 직급을 사용자에게 직접 입력하는 것도 계속 허용된다.
model JobTitle {
  id        String   @id @default(cuid())
  name      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([sortOrder])
}

model Department {
  id           String  @id @default(cuid())
  name         String
  companyId    String
  // 상위 부서. null이면 회사 바로 아래(최상위) 부서.
  parentId     String?
  // 같은 상위 부서 안에서의 조회 순번. 작을수록 먼저 나온다.
  sortOrder    Int      @default(0)
  /// 거래처 MSSQL 부서코드 (DEPT_CD / dept_code)
  externalCode String?
  company      Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // 상위 부서가 지워지면 하위 부서는 최상위로 올라간다(연쇄 삭제 방지).
  parent       Department?  @relation("DepartmentTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     Department[] @relation("DepartmentTree")
  users        User[]
  affiliations UserAffiliation[]

  @@unique([companyId, externalCode])
  @@index([companyId])
  @@index([parentId])
  @@index([externalCode])
}

model User {
  id              String        @id @default(cuid())
  email           String        @unique
  password        String
  name            String
  phone           String?       // 연락처(휴대폰)
  extension       String?       // 사내 내선번호
  deskPhone       String?       // 자리 전화번호(구내 유선)
  jobTitle        String?       // 직급 (대리, 과장, 팀장 등)
  avatarUrl       String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  departmentId    String?
  statusMessage   String?       // 프레즌스 상태(온라인/자리비움 등)
  statusNote      String?       // 자유 상태 메시지
  notepad         String?       // 개인 메모장(본인만 보임, 자동저장)
  mustChangePassword Boolean    @default(false) // 거래처 자동계정 등 공용 초기비밀번호로 생성된 계정 → 최초 로그인 시 강제 변경
  /// 거래처 MSSQL 사원 PK (hr_employee_master_id)
  externalEmpId   String?       @unique
  bookmarks       Bookmark[]
  sentMessages    Message[]     @relation("Sender")
  readReceipts    ReadReceipt[]
  roomMemberships RoomMember[]
  department      Department?   @relation(fields: [departmentId], references: [id])
  affiliations    UserAffiliation[]
  sessions        UserSession[]
  createdRooms    Room[]        @relation("RoomCreator")
  deviceTokens    DeviceToken[]
  sentMemos       Memo[]           @relation("SentMemos")
  receivedMemos   MemoRecipient[]  @relation("ReceivedMemos")
  orgGroups            OrgGroup[]
  orgGroupMemberships  OrgGroupMember[]

  @@index([departmentId])
}

/// 겸직 소속. User.departmentId는 메신저에 표시할 현재 법인/부서.
model UserAffiliation {
  id           String     @id @default(cuid())
  userId       String
  departmentId String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([userId, departmentId])
  @@index([userId])
  @@index([departmentId])
}

model Room {
  id             String          @id @default(cuid())
  name           String?
  avatarUrl      String?
  initials       String?         // 프로필 이니셜 (최대 2글자, 이미지 없을 때 표시)
  isGroup        Boolean         @default(false)
  isTopic        Boolean         @default(false)  // true=아젠다, false=그룹채팅(채팅 섹션)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  isPublic       Boolean         @default(false)
  description    String?
  viewMode       String          @default("chat")
  createdBy      String?         // 아젠다 생성자 (방 설정 권한)
  creator        User?           @relation("RoomCreator", fields: [createdBy], references: [id])
  messages       Message[]
  pinnedMessages PinnedMessage[]
  projects       Project[]
  members        RoomMember[]

  @@index([createdBy])
}

model RoomMember {
  id         String    @id @default(cuid())
  userId     String
  roomId     String
  joinedAt   DateTime  @default(now())
  lastReadAt DateTime?
  isFavorite Boolean   @default(false)
  leftAt     DateTime?
  folderId   String?
  folder     Folder?   @relation(fields: [folderId], references: [id])
  room       Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roomId])
  @@index([userId])
  @@index([roomId])
  @@index([folderId])
}

model Message {
  id               String          @id @default(cuid())
  roomId           String
  senderId         String
  content          String
  createdAt        DateTime        @default(now())
  fileExpiresAt    DateTime?
  fileMimeType     String?
  fileName         String?
  fileSize         BigInt?
  fileUrl          String?
  eventDescription String?
  eventEndAt       DateTime?
  eventStartAt     DateTime?
  eventTitle       String?
  deletedAt        DateTime?
  editedAt         DateTime?
  replyToId        String?
  contextFilePath  String?   // 컨텍스트 스택: 파일 경로
  contextLine      Int?      // 컨텍스트 스택: 라인 번호
  contextBranch    String?   // 컨텍스트 스택: 브랜치
  bookmarks        Bookmark[]
  mentions         Mention[]
  replyTo          Message?        @relation("Reply", fields: [replyToId], references: [id])
  replies          Message[]       @relation("Reply")
  room             Room            @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender           User            @relation("Sender", fields: [senderId], references: [id], onDelete: Cascade)
  pinnedIn         PinnedMessage[]
  poll             Poll?
  reactions        Reaction[]
  readReceipts     ReadReceipt[]

  @@index([roomId])
  @@index([senderId])
  @@index([roomId, createdAt])
  @@index([roomId, senderId, createdAt])
  @@index([fileExpiresAt])
}

model Event {
  id          String   @id @default(cuid())
  userId      String
  title       String
  startAt     DateTime
  endAt       DateTime
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([startAt])
}

model ReadReceipt {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  readAt    DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId])
}

model Announcement {
  id        String   @id @default(cuid())
  title     String?
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserSession {
  id        String   @id @default(cuid())
  userId    String
  createdAt DateTime @default(now())
  lastSeen  DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Reaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

model Mention {
  id        String    @id @default(cuid())
  messageId String
  userId    String
  readAt    DateTime?
  message   Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([userId])
}

model Poll {
  id         String       @id @default(cuid())
  messageId  String       @unique
  question   String
  isMultiple Boolean      @default(false)
  createdAt  DateTime     @default(now())
  message    Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  options    PollOption[]
}

model PollOption {
  id     String     @id @default(cuid())
  pollId String
  text   String
  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes  PollVote[]

  @@index([pollId])
}

model PollVote {
  id       String     @id @default(cuid())
  optionId String
  userId   String
  option   PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([optionId, userId])
  @@index([optionId])
}

model PinnedMessage {
  id        String   @id @default(cuid())
  roomId    String
  messageId String
  pinnedBy  String
  pinnedAt  DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, messageId])
  @@index([roomId])
}

model Project {
  id          String   @id @default(cuid())
  roomId      String
  name        String
  description String?
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  boards      Board[]
  room        Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  tasks       Task[]

  @@index([roomId])
}

model Board {
  id        String  @id @default(cuid())
  projectId String
  name      String
  position  Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@index([projectId])
}

model Task {
  id          String        @id @default(cuid())
  projectId   String
  boardId     String
  title       String
  description String?
  assigneeId  String?
  priority    String        @default("medium")
  dueDate     DateTime?
  position    Int           @default(0)
  createdBy   String
  messageId   String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  startDate   DateTime?
  board       Board         @relation(fields: [boardId], references: [id], onDelete: Cascade)
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  comments    TaskComment[]

  @@index([projectId])
  @@index([boardId])
  @@index([assigneeId])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  content   String
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  messageId String
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, messageId])
  @@index([userId])
}

model Folder {
  id              String       @id @default(cuid())
  userId          String
  name            String
  createdAt       DateTime     @default(now())
  roomMemberships RoomMember[]

  @@index([userId])
}

// 조직도 개인 연락처 그룹 (채팅 Folder와 별개)
model OrgGroup {
  id        String           @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  members   OrgGroupMember[]

  @@index([userId])
}

model OrgGroupMember {
  id           String   @id @default(cuid())
  groupId      String
  memberUserId String
  createdAt    DateTime @default(now())
  group        OrgGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  member       User     @relation(fields: [memberUserId], references: [id], onDelete: Cascade)

  @@unique([groupId, memberUserId])
  @@index([groupId])
  @@index([memberUserId])
}

model DeviceToken {
  id        String   @id @default(cuid())
  userId    String
  token     String
  platform  String   // "ios" | "android" | "web"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, token])
  @@index([userId])
}

model Memo {
  id         String          @id @default(cuid())
  senderId   String
  subject    String
  body       String
  createdAt  DateTime        @default(now())
  sender     User            @relation("SentMemos", fields: [senderId], references: [id], onDelete: Cascade)
  recipients MemoRecipient[]

  @@index([senderId])
  @@index([createdAt])
}

model MemoRecipient {
  id        String    @id @default(cuid())
  memoId    String
  userId    String
  readAt    DateTime?
  deletedAt DateTime?
  memo      Memo      @relation(fields: [memoId], references: [id], onDelete: Cascade)
  user      User      @relation("ReceivedMemos", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([memoId, userId])
  @@index([userId, readAt])
  @@index([userId, deletedAt])
}

/// 앱 전역 설정. 사이드바 링크 주소처럼 모든 사용자에게 같은 값을 쓸 때 쓴다.
model AppSetting {
  key       String   @id
  value     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
