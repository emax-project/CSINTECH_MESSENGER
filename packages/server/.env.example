# PostgreSQL (로컬: Docker DB 사용 시, 호스트 포트 5433)
DATABASE_URL="postgresql://message:message@localhost:5433/message"

# 서버
PORT=3001

# JWT (운영 환경에서는 반드시 변경)
JWT_SECRET=change-me-in-production

# 공지 등록 권한 (이 이메일로 로그인한 사용자만 더보기 탭에서 공지 등록 가능. 쉼표로 여러 명 지정 가능)
# ADMIN_EMAIL=admin@example.com
# ADMIN_EMAIL=clown@naver.com,other@example.com

# ---------------------------------------------------------------------------
# 거래처 MSSQL 조직도 연동 (옵션)
# PARTNER_ORG_SOURCE=off | mock | mssql
#   off  : 사용 안 함 (기본)
#   mock : IP 열리기 전 로컬 검증용 목 데이터
#   mssql: 실제 거래처 DB
# ---------------------------------------------------------------------------
# PARTNER_ORG_SOURCE=mssql
# PARTNER_COMPANY_NAME=CSIN
# PARTNER_COMPANY_EXTERNAL_CODE=CSIN
# PARTNER_WORK_STATE_ACTIVE=hr009100
#
# # 외부 9213 = MS-SQL (내부 192.168.123.211:1433). 9210은 WEB RDP이므로 사용하지 말 것.
# PARTNER_MSSQL_SERVER=121.143.3.163
# PARTNER_MSSQL_PORT=9213
# PARTNER_MSSQL_DATABASE=CSI_GW
# PARTNER_MSSQL_USER=
# PARTNER_MSSQL_PASSWORD=
# PARTNER_MSSQL_ENCRYPT=false
# PARTNER_MSSQL_TRUST_CERT=true
# 계정 자동 생성 시 초기 비밀번호 (--create-users / createMissingUsers 사용 시 필수).
# 기본값 없음 — 안전한 값으로 직접 설정할 것. 새 계정은 최초 로그인 시
# 비밀번호 변경이 강제된다 (User.mustChangePassword).
# PARTNER_DEFAULT_PASSWORD=
#
# ---------------------------------------------------------------------------
# Synology LDAP (그룹웨어·ERP와 동일 계정)
# LDAP_ENABLED=true 이면 관리자/예외 계정만 로컬 비밀번호, 나머지는 LDAP bind
# 로그인 ID = uid (이메일 @ 앞부분, 예: wtkim@csin.kr → wtkim)
# ---------------------------------------------------------------------------
# LDAP_ENABLED=false
# LDAP_URL=ldaps://ldap.csin.kr:636
# LDAP_BASE_DN=dc=ldap,dc=csin,dc=kr
# LDAP_SEARCH_BASE=cn=users,dc=ldap,dc=csin,dc=kr
# LDAP_SEARCH_FILTER=(&(objectClass=posixAccount)(uid=%s)(!(shadowExpire=1)))
# LDAP_BIND_DN=uid=ldap_gw,cn=users,dc=ldap,dc=csin,dc=kr
# LDAP_BIND_PASSWORD=
# LDAP_EMAIL_DOMAIN=csin.kr
# LDAP_TLS_REJECT_UNAUTHORIZED=true
# # LDAP에 넣지 않는 비상/외부 계정 (ADMIN_EMAIL은 자동 포함)
# LDAP_LOCAL_EXCEPTIONS=
