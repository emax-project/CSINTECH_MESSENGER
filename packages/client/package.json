{
  "name": "client",
  "version": "1.2.47",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "build:icon": "node scripts/build-icon.js",
    "build": "vite build",
    "preview": "vite preview",
    "generate-updater-config": "node scripts/generate-updater-config.js",
    "electron:build": "npm run build && npm run generate-updater-config && electron-builder --publish never",
    "electron:build:mac": "npm run build && npm run generate-updater-config && electron-builder --mac --publish never",
    "electron:build:win": "npm run build && npm run generate-updater-config && electron-builder --win --x64 --arm64 --publish never",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "lighthouse": "npx lighthouse http://localhost:5173 --output=html --output-path=./lighthouse-report.html --view",
    "lighthouse:preview": "npm run build && concurrently -k -s first \"npm run preview\" \"wait-on http://localhost:4173 && npx lighthouse http://localhost:4173/login --output=html --output-path=./lighthouse-report.html --view\"",
    "lighthouse:ci": "concurrently -k -s first \"npm run dev\" \"wait-on http://localhost:5173 && npx lighthouse http://localhost:5173 --output=html --output-path=./lighthouse-report.html --chrome-flags='--headless --no-sandbox'\""
  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.0",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "dompurify": "^3.3.1",
    "electron-updater": "^6.7.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^3.8.0",
    "socket.io-client": "^4.7.5",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/dompurify": "^3.0.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.0.1",
    "electron": "39.8.10",
    "electron-builder": "^26.15.3",
    "eslint": "^8.56.0",
    "eslint-plugin-react": "^7.36.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jsdom": "^29.0.0",
    "png-to-ico": "^3.0.1",
    "png2icons": "^2.0.1",
    "postcss": "^8.5.8",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.6.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.11",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.csintech.message",
    "productName": "CSIN-Tech",
    "electronVersion": "33.2.0",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "emax-project",
        "repo": "MESSAGE"
      }
    ],
    "files": [
      "dist/**",
      "electron/**",
      "build/icons/**"
    ],
    "mac": {
      "category": "public.app-category.social",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icons/icon.icns"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icons/icon.ico",
      "artifactName": "CSIN-Tech-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
