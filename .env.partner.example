# 거래처 GW 서버(192.168.123.210)용 — 복사: cp .env.partner.example .env
# 사외 클라이언트: http://121.143.3.163:3030  (UTM 1442: 3030 → 210:3001)

JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=

PARTNER_ORG_SOURCE=mssql
PARTNER_COMPANY_NAME=CSIN
PARTNER_COMPANY_EXTERNAL_CODE=CSIN
# 거래처 망 내부에서는 SQL 직접 접속
PARTNER_MSSQL_SERVER=192.168.123.211
PARTNER_MSSQL_PORT=1433
PARTNER_MSSQL_DATABASE=CSI_GW
PARTNER_MSSQL_USER=
PARTNER_MSSQL_PASSWORD=
PARTNER_MSSQL_ENCRYPT=false
PARTNER_MSSQL_TRUST_CERT=true
PARTNER_DEFAULT_PASSWORD=123456

# Synology LDAP — 거래처 망에서 ldap.csin.kr (hosts → 192.168.123.247)
# LDAP_ENABLED=true
# LDAP_URL=ldaps://ldap.csin.kr:636
# LDAP_BASE_DN=dc=ldap,dc=csin,dc=kr
# LDAP_SEARCH_BASE=cn=users,dc=ldap,dc=csin,dc=kr
# LDAP_SEARCH_FILTER=(&(objectClass=posixAccount)(uid=%s)(!(shadowExpire=1)))
# LDAP_BIND_DN=uid=ldap_gw,cn=users,dc=ldap,dc=csin,dc=kr
# LDAP_BIND_PASSWORD=
# LDAP_EMAIL_DOMAIN=csin.kr
# LDAP_TLS_REJECT_UNAUTHORIZED=true
# LDAP_LOCAL_EXCEPTIONS=

# 새 메일 팝업 알림 — 메일 서버(MailCarrier) DB의 메일 알림 목록(WpuMailNotifyList)을 읽어 접속 중인 수신자에게 팝업을 띄운다 (docs/mail-notify.md)
# 켜기 전에 메일 DB 읽기 전용 계정(필요한 테이블·컬럼 SELECT만, docs/mail-notify.md 참고)을 만들어 아래에 넣는다. 기본은 꺼짐.
# MAIL_WATCH_ENABLED=true
# MAIL_MSSQL_SERVER=          # 비우면 PARTNER_MSSQL_SERVER 사용
# MAIL_MSSQL_PORT=            # 비우면 PARTNER_MSSQL_PORT 사용
# MAIL_MSSQL_DATABASE=MC7
# MAIL_MSSQL_USER=
# MAIL_MSSQL_PASSWORD=
# MAIL_WATCH_SHOW_SUBJECT=true   # false면 팝업에 제목을 보여주지 않고 보낸 사람만 표시
# MAIL_WATCH_INTERVAL_SEC=15     # 조회 주기(5~300초)
# MAIL_WATCH_MAX_AGE_SEC=600     # 이보다 오래된 메일은 알리지 않음(서버 재시작 직후 폭주 방지)
# MAIL_WATCH_DB_TIME=utc         # 메일 DB가 알림 시각을 저장하는 기준 (utc | local). MailCarrier는 utc
